# ==========================================
# Unity Standard .gitignore
# ==========================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset store packages (Unity Package Manager handles packages via Packages/manifest.json)
AssetStore-cache/
Packages/generated.*

# Do not ignore .meta files for folders/files, but ignore for generated ones
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports & system info
sysinfo.txt
*.stackdump

# ==========================================
# Code Editor & IDE Files
# ==========================================

# Visual Studio / Visual Studio Code / Rider generated project files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Visual Studio
.vs/

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# ==========================================
# OS Specific Files
# ==========================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ==========================================
# Build Artifacts
# ==========================================
*.apk
*.aab
*.unitypackage
*.app
